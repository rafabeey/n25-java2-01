package br.com.senaisp.bauru;

import javax.management.InvalidApplicationException;

import javafx.application.Application;
import javafx.event.ActionEvent;
import javafx.event.EventHandler;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.layout.StackPane;
import javafx.stage.Stage;

public class JavaFx_Main extends Application {

	@Override
	public void start(Stage primaStage) throws Exception {
      Button btn = new Button();
      btn.setText("Diga \"Olá Mundo!\"");
      btn.setOnAction(new EventHandler<ActionEvent>() {
		
		@Override
		public void handle(ActionEvent arg0) {
         System.out.println("Olá mundo!");
         
		}
	});
      
      StackPane root = new StackPane();
      root.getChildren().add(btn); //adicionando o botão no painel
      //                          altura, comprimento
      Scene cena = new Scene(root,300,500);
      primaStage.setTitle("Minha primeira janela no JavaFX");
      primaStage.setScene(cena); //Atribuindo a cena para a janela
      primaStage.show(); //Mostra a janela
      
	}
	public static void main(String[] args) {
		launch(args); 
		
	}

}
